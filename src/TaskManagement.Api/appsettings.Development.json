{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "App": {
    "PublicBaseUrl": "http://localhost:4200"
  },
  "Auth": {
    "CookieName": "tma",
    "AntiforgeryCookieName": "tma-af",
    "RequireSecureCookies": false
  },
  "Email": {
    "Transport": "PickupDirectory",
    "PickupDirectory": "../../storage/mail"
  },
  "Attachments": {
    "LocalPath": "../../storage/files",
    "Scanner": "None"
  }
}
